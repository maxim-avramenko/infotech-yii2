COMPOSE_PROJECT_NAME=infotech-yii2
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

APP_DOMAIN=infotech-yii2.localhost
ADMINER_DOMAIN=adminer.infotech-yii2.localhost
YII_ENV=dev
YII_DEBUG=1
COOKIE_VALIDATION_KEY=change-me

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=book_store
MYSQL_USER=infotech
MYSQL_PASSWORD=infotech

DB_HOST=mysql
DB_PORT=3306
DB_NAME=book_store
TEST_DB_NAME=book_store_test
DB_USER=infotech
DB_PASSWORD=infotech

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211

MAIL_USE_FILE_TRANSPORT=1
SMS_USE_FILE_TRANSPORT=0
SMS_API_URL=https://smspilot.ru/api.php
SMS_API_KEY=
SMS_FROM=
SMS_TEST=1
SMS_CALLBACK_URL=
SMS_CALLBACK_METHOD=post
QUEUE_EMAIL_CHANNEL=queue-email
QUEUE_SMS_CHANNEL=queue-sms
